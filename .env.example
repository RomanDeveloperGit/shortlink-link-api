# [!!!] Don't use the .env file, but use the inline environment variables (Taskfile / Docker / manually)

ENV=local|dev|prod|test

SERVICE_NAME=shortlink-link-api
SERVICE_VERSION=0.0.0

SHORT_CODE_LENGTH=7
ATTEMPTS_GENERATE_SHORT_CODE_LIMIT=5
GRACEFUL_SHUTDOWN_PER_RESOURCE_TIMEOUT=15s

# можно добавить таймауты для работы с БД на одну операцию, на работу с кэшем на одну операцию, на кафку разные таймауты накинуть (за счет этого можно поубирать шатдауны некоторых ресурсов с утечкой памяти)

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_IDLE_TIMEOUT=10s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=shortlink_link_api_db
POSTGRES_SSL_MODE=disable
POSTGRES_MAX_IDLE_CONNS=10
POSTGRES_MAX_OPEN_CONNS=100
POSTGRES_CONN_MAX_LIFETIME=5m
POSTGRES_PING_TIMEOUT=5s

KAFKA_BROKERS=localhost:9094,localhost:9095,localhost:9096
KAFKA_USER=link-api
KAFKA_PASSWORD=link-api-secret

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=admin
REDIS_PASSWORD=admin
REDIS_PING_TIMEOUT=5s
